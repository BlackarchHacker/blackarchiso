#!/usr/bin/env bash

MONITOR="eDP-1"

monitor-sensor | while read -r line; do
  case "$line" in
    *"normal"*)
      hyprctl keyword monitor "$MONITOR,1920x1080@144, auto, 1.5,transform,0"
      hyprctl keyword input:touchdevice:transform 0
      ;;
    *"left-up"*)
      hyprctl keyword monitor "$MONITOR,1920x1080@144, auto, 1.5,transform,1"
      hyprctl keyword input:touchdevice:transform 1
      ;;
    *"bottom-up"*)
      hyprctl keyword monitor "$MONITOR,1920x1080@144, auto, 1.5,transform,2"
      hyprctl keyword input:touchdevice:transform 2
      ;;
    *"right-up"*)
      hyprctl keyword monitor "$MONITOR,1920x1080@144, auto, 1.5,transform,3"
      hyprctl keyword input:touchdevice:transform 3
      ;;
  esac
done

